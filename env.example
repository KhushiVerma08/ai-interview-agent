# ─── REQUIRED ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ─── SERVER ─────────────────────────────────────────────
PORT=3000

# ─── EMAIL (optional — for sending reports to recruiter) ─
# Uses Gmail SMTP. Enable "App Passwords" in Google Account > Security
EMAIL_USER=your_gmail_id_here
EMAIL_PASS=your_gmail_passkey_here
# ─── INTERVIEW DEFAULTS ──────────────────────────────────
DEFAULT_QUESTION_COUNT=7
ENABLE_FOLLOW_UPS=true
GEMINI_API_KEY=your_anthropic_gemini_api_key_here


#===============teams meeting=====================
AZURE_CLIENT_ID=your_client_id_here

AZURE_TENANT_ID=your_tenant_id_here

AZURE_CLIENT_SECRET=your_client_secret_key_here

# Auth (If applicable)
JWT_SECRET=supersecretkey

# Recall.ai Integration
RECALL_API_KEY=your_recall_ai_api_key
APP_BASE_URL=https://your-domain.com

#MEETING_PROVIDER=teams
TEAMS_ENABLED=false

